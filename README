#краткое описание проекта и инструкции по запуску тестов
запуск всех тестов
python -m pytest -v

запуск одного теста
python -m pytest selenium_tests/test_cart.py -v


формирование отчета с помощью команды
pytest --alluredir=allure-results
allure generate allure-results --clean -o allure-report
allure open allure-report
очистка папки с результатами перед новым запуском тестов
rm -rf allure-results
